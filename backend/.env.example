[DEBUG]
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ENV=production
ALLOWED_HOSTS=localhost,127.0.0.1,simbagrandtours.com

[DATABASE]
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=simba_grand_tours
DB_USER=simba_grand_tours
DB_PASSWORD=replace-with-the-database-password

[CORS]
ALLOWED_ORIGINS=https://simbagrandtours.com,https://admin.simbagrandtours.com

[MEDIA]
MEDIA_URL=/media/
MEDIA_ROOT=media/

[MPESA]
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# For a production Till, set CustomerBuyGoodsOnline.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://your-backend-domain/api/payments/mpesa/callback
MPESA_CALLBACK_TOKEN=generate-a-long-random-secret

[EMAIL]
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

[AFRICAS_TALKING_SMS]
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_ENVIRONMENT=sandbox

[WHATSAPP_CLOUD_API]
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_BOOKING_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_WAITLIST_TEMPLATE=

